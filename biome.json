{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"formatter": {
		"indentWidth": 4,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off",
				"noAssignInExpressions": "off",
				"noImplicitAnyLet": "off",
				"noDebugger": "off"
			},
			"style": {
				"useConst": "error"
			},
			"complexity": {
				"noStaticOnlyClass": "off",
				"noBannedTypes": "off",
				"noUselessSwitchCase": "off"
			},
			"correctness": {
				"noSelfAssign": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "none",
			"bracketSpacing": false
		}
	}
}
