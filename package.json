{
	"title": "@c2stack/html2canvas",
	"name": "@c2stack/html2canvas",
	"description": "Screenshots with JavaScript",
	"version": "1.4.1",
	"type": "module",
	"main": "dist/html2canvas.js",
	"module": "dist/html2canvas.esm.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/html2canvas.esm.js",
			"require": "./dist/html2canvas.js",
			"default": "./dist/html2canvas.esm.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"author": {
		"name": "c2stack",
		"email": "info@cchaensel.de",
		"url": "https://cchaensel.de"
	},
	"engines": {
		"bun": ">=1.0.0"
	},
	"packageManager": "bun@1.1.42",
	"repository": {
		"type": "git",
		"url": "git@github.com:carlchrhaensel/c2stack-html2canvas.git"
	},
	"bugs": {
		"url": "https://github.com/carlchrhaensel/c2stack-html2canvas/issues"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@changesets/cli": "^2.27.11",
		"@playwright/test": "^1.49.1",
		"@types/bun": "^1.1.13",
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.5",
		"@types/platform": "^1.3.6",
		"@vitest/coverage-v8": "2.1.9",
		"@vitest/ui": "^2.1.8",
		"base64-arraybuffer": "1.0.1",
		"body-parser": "^1.20.3",
		"cors": "^2.8.5",
		"express": "^4.21.2",
		"filenamify-url": "1.0.0",
		"glob": "11.0.0",
		"html2canvas-proxy": "1.0.1",
		"husky": "^9.1.7",
		"jquery": "^3.5.1",
		"jsdom": "^25.0.1",
		"lint-staged": "^15.2.11",
		"platform": "^1.3.6",
		"serve-index": "^1.9.1",
		"typescript": "^5.7.2",
		"vite": "7.3.1",
		"vite-plugin-banner": "0.8.1",
		"vitest": "^2.1.8",
		"yargs": "^17.7.2"
	},
	"scripts": {
		"dev": "vite build --watch",
		"prebuild": "bun scripts/cleanup.ts",
		"build": "tsc && vite build && bun run build:create-reftest-list && bun run build:testrunner",
		"build:testrunner": "vite build --config tests/vite.config.ts",
		"build:reftest-result-list": "bun scripts/create-reftest-result-list.ts",
		"build:create-reftest-list": "bun scripts/create-reftest-list.ts tests/reftests/ignore.txt build/reftests.ts",
		"release": "changeset publish",
		"changeset": "changeset",
		"version": "changeset version",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "bun run lint && bun run test:unit && bun run test:browser",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:browser": "playwright test",
		"reftests-diff": "bun scripts/prepare-reftests.ts && vitest run --config vitest.config.ts tests/reftest-diff.ts",
		"start": "bun tests/server.ts --port=8080 --cors=8081",
		"postinstall": "bun scripts/patch-toidentifier.js",
		"prepare": "husky"
	},
	"homepage": "https://html2canvas.hertzen.com",
	"license": "MIT",
	"dependencies": {
		"css-line-break": "^2.1.0",
		"text-segmentation": "^1.0.3"
	}
}
